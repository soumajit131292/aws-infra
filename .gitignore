##################################
# Terraform
##################################

# Local .terraform directories
.terraform/
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Terraform CLI config files
.terraformrc
terraform.rc

# Override files (used by terraform plan/apply -var-file)
*.tfvars
*.tfvars.json

# Lock file (KEEP or IGNORE? see note below)
#.terraform.lock.hcl

##################################
# Sensitive files
##################################

# Environment variable files
.env
.env.*

# Credentials
*.pem
*.key
*.crt
*.p12
*.jks

##################################
# Editor / OS noise
##################################

# macOS
.DS_Store

# VS Code
.vscode/

# IntelliJ
.idea/

##################################
# Logs
##################################
*.log


